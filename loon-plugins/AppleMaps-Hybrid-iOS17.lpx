#!name = Apple Maps iOS17 · MapKit Main Full Hybrid US
#!desc = 跟随 NSRingo MapKit 当前 main 架构：默认强制 US 资源清单，并使用当前 MapKit 完整地图合成逻辑（地图、2D/3D 卫星、交通、POI、Flyover、Look Around/Munin、道路、地球、公共交通等）。保留大陆高德相关服务直连；不修改系统 LocationService 地区检测。
#!author = NSRingo / VirgilClyne; Main Full Hybrid wrapper by Dreaminmaster
#!homepage = https://github.com/NSRingo/MapKit
#!icon = https://developer.apple.com/assets/elements/icons/maps/maps-128x128.png
#!tag = Apple Maps,iRingo,MapKit,Main
#!system = iOS,iPadOS,macOS
#!system_version = 15

# ============================================================
# 【地区模式：只改这里对应 Rewrite 行里的一个值】
# 当前默认：US
# 想恢复自动：在下面“Resource Manifest / Geo Manifest”那一行里，
# 把：GeoManifest.Dynamic.Config.CountryCode=US
# 改成：GeoManifest.Dynamic.Config.CountryCode=AUTO
#
# AUTO ≠ 关闭插件。
# AUTO 只是不再强制地图资源清单国家；MapKit 的完整资源合成、
# POI/交通/卫星/道路/Look Around 等处理仍然继续工作。
# ============================================================

[Rule]
# Amap / mainland Apple Maps services: keep direct for mainland coordinate/data compatibility.
DOMAIN-SUFFIX,is.autonavi.com,DIRECT
DOMAIN,gspe11-2-cn-ssl.ls.apple.com,DIRECT
DOMAIN,gspe12-cn-ssl.ls.apple.com,DIRECT
DOMAIN,gspe19-cn-ssl.ls.apple.com,DIRECT
DOMAIN,gspe19-2-cn-ssl.ls.apple.com,DIRECT
DOMAIN,gspe79-cn-ssl.ls.apple.com,DIRECT

[Rewrite]
# Current MapKit main architecture uses the official Pages endpoint.
# 1) Network Defaults: Dispatcher / Directions / RAP / LocationShift and related service configuration.
^https?:\/\/configuration\.ls\.apple\.com\/config\/defaults https://mapkit.pages.dev/config/defaults header

# 2) Announcements: keep current upstream/main behavior.
^https?:\/\/gspe35-ssl\.ls\.apple\.com\/config\/announcements https://mapkit.pages.dev/config/announcements header

# 3) Resource Manifest / Geo Manifest.
# ★ DEFAULT US. To switch to AUTO, change ONLY the following US to AUTO.
# Capture and preserve Apple's original query parameters while adding the MapKit setting.
^https?:\/\/gspe35-ssl\.ls\.apple\.(com|cn)\/geo_manifest\/dynamic\/config(?:\?(.*))?$ https://mapkit.pages.dev/geo_manifest/dynamic/config?GeoManifest.Dynamic.Config.CountryCode=US&$2 header

[MITM]
hostname = configuration.ls.apple.com, gspe35-ssl.ls.apple.com
